# {%.Name%} — built by CI, deployed by ArgoCD.
#
# Generated by platform-cli. The platform runs this image non-root with a
# read-only root filesystem and every capability dropped, so the runtime stage
# must not write outside an explicitly mounted volume.

FROM node:22-alpine AS build
WORKDIR /src

# package*.json first: this layer is cached until your dependencies change.
COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build --if-present && npm prune --omit=dev

FROM node:22-alpine
ARG VERSION=dev
# NPM_CONFIG_UPDATE_NOTIFIER: npm writes its update check to ~/.npm on startup,
# which a read-only rootfs refuses.
ENV NODE_ENV=production \
    APP_VERSION=${VERSION} \
    PORT={%.Port%} \
    NPM_CONFIG_UPDATE_NOTIFIER=false

WORKDIR /app
COPY --from=build --chown=1000:1000 /src ./

EXPOSE {%.Port%}
# 1000 is the `node` user the image already ships, written numerically: the
# chart sets runAsNonRoot without pinning runAsUser, and the kubelet cannot
# resolve a username against the image at admission, so `USER node` would fail
# with "cannot verify user is non-root" and never start.
USER 1000:1000

# Point this at your entrypoint. Do not use `npm start`: it forks a shell and
# swallows SIGTERM, so Kubernetes waits out the full termination grace period
# on every rollout.
CMD ["node", "server.js"]
