# {%.Name%} — built by CI, deployed by ArgoCD.
#
# Generated by platform-cli. The platform runs this image non-root with a
# read-only root filesystem and every capability dropped, so the runtime stage
# must not write outside an explicitly mounted volume.

FROM python:3.12-slim AS build
WORKDIR /src

COPY requirements.txt ./
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

FROM python:3.12-slim
ARG VERSION=dev
# A read-only rootfs cannot take .pyc files, and unbuffered stdout is what makes
# your logs show up without waiting for a flush.
ENV APP_VERSION=${VERSION} \
    PORT={%.Port%} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY --from=build /install /usr/local
WORKDIR /app
COPY . .

# An explicit high uid, so the chart's runAsNonRoot check passes and the number
# does not collide with anything the base image already created.
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin app
USER 10001

EXPOSE {%.Port%}
# Adjust the module path to your app. --host 0.0.0.0 is required: binding
# localhost makes the pod unreachable from the kubelet's probes.
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "{%.Port%}"]
