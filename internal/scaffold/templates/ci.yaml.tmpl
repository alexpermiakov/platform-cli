# CI for {%.Name%}, owned by {%.Team%}.
#
# Generated by platform-cli. Pushing a vX.Y.Z tag builds the image, pushes it
# to ECR, and opens a PR against the platform repo bumping the deployed tag.
# ArgoCD syncs when that PR merges.

name: CI

on:
  push:
    branches: [main]
    tags: ["v*.*.*"]
  pull_request:
    branches: [main]

permissions:
  contents: read

env:
  SERVICE_NAME: {%.Name%}
  ECR_REPOSITORY: {%.ECRRepository%}
  AWS_REGION: {%.Region%}
  PLATFORM_REPO: {%.PlatformRepo%}

jobs:
  quality-gate:
    name: Lint and test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: "1.24"
          cache: true

      - uses: golangci/golangci-lint-action@v6
        with:
          version: latest

      - run: go test -race -covermode=atomic ./...

  build:
    name: Build and push
    needs: quality-gate
    if: github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
    outputs:
      image: ${{ steps.build.outputs.image }}
    steps:
      - uses: actions/checkout@v4

      - name: Derive image tag
        id: meta
        run: |
          if [[ $GITHUB_REF == refs/tags/* ]]; then
            echo "tag=${GITHUB_REF#refs/tags/}" >> $GITHUB_OUTPUT
          else
            echo "tag=sha-${GITHUB_SHA::7}" >> $GITHUB_OUTPUT
          fi

      - uses: aws-actions/configure-aws-credentials@v5.1.1
        with:
          role-to-assume: ${{ vars.AWS_ROLE_ARN }}
          aws-region: ${{ env.AWS_REGION }}
          audience: sts.amazonaws.com

      - uses: aws-actions/amazon-ecr-login@v2
        id: ecr

      - name: Build and push
        id: build
        env:
          REGISTRY: ${{ steps.ecr.outputs.registry }}
          TAG: ${{ steps.meta.outputs.tag }}
        run: |
          IMAGE="$REGISTRY/$ECR_REPOSITORY:$TAG"
          docker build --build-arg VERSION="$TAG" -t "$IMAGE" .
          docker push "$IMAGE"
          echo "image=$IMAGE" >> $GITHUB_OUTPUT

      # Kyverno rejects images from untrusted registries and images tagged
      # :latest at admission, so a failure here is cheaper than a failed sync.
      - name: Scan image
        uses: aquasecurity/trivy-action@0.35.0
        with:
          image-ref: ${{ steps.build.outputs.image }}
          format: table
          exit-code: "1"
          ignore-unfixed: true
          severity: HIGH,CRITICAL

  deploy:
    name: Request deploy to dev
    needs: build
    if: startsWith(github.ref, 'refs/tags/v')
    runs-on: ubuntu-latest
    steps:
      # A GitHub App scoped to the platform repo — not a PAT — so the token is
      # short-lived and its access is auditable per-repository.
      - name: Mint platform repo token
        id: token
        uses: actions/create-github-app-token@v1
        with:
          app-id: ${{ vars.PLATFORM_APP_ID }}
          private-key: ${{ secrets.PLATFORM_APP_PRIVATE_KEY }}
          owner: ${{ github.repository_owner }}
          repositories: {%.PlatformRepoName%}

      - uses: actions/checkout@v4
        with:
          repository: ${{ env.PLATFORM_REPO }}
          token: ${{ steps.token.outputs.token }}
          path: platform

      - name: Bump image tag
        working-directory: platform
        env:
          IMAGE: ${{ needs.build.outputs.image }}
          GH_TOKEN: ${{ steps.token.outputs.token }}
        run: |
          set -euo pipefail
          VERSION="${GITHUB_REF#refs/tags/}"
          FILE="argocd/applications/dev/values/${SERVICE_NAME}.yaml"

          if [ ! -f "$FILE" ]; then
            echo "::error::$FILE does not exist in $PLATFORM_REPO."
            echo "The service has not been onboarded. Run 'platform init' and merge that PR first."
            exit 1
          fi

          BRANCH="deploy/${SERVICE_NAME}-${VERSION}"
          git config user.name "platform-ci[bot]"
          git config user.email "platform-ci[bot]@users.noreply.github.com"
          git checkout -b "$BRANCH"

          yq -i '.app.image = strenv(IMAGE)' "$FILE"

          if git diff --quiet; then
            echo "::notice::$FILE already points at $IMAGE; nothing to do."
            exit 0
          fi

          git commit -am "deploy: ${SERVICE_NAME} ${VERSION} to dev"
          git push origin "$BRANCH"

          gh pr create \
            --repo "$PLATFORM_REPO" \
            --base main \
            --head "$BRANCH" \
            --title "deploy: ${SERVICE_NAME} ${VERSION} to dev" \
            --body "Image: \`${IMAGE}\`
          Requested by @${GITHUB_ACTOR} from ${GITHUB_REPOSITORY}@${GITHUB_SHA:0:7}."
