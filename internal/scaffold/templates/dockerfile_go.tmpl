# {%.Name%} — built by CI, deployed by ArgoCD.
#
# Generated by platform-cli. The platform runs this image non-root with a
# read-only root filesystem and every capability dropped, so the runtime stage
# must not write outside an explicitly mounted volume.

FROM golang:1.24-alpine AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
# CI passes the git tag; it ends up in /version and your metrics.
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath \
      -ldflags "-s -w -X main.version=${VERSION}" \
      -o /out/app .

# distroless/static: no shell, no package manager, nothing to exploit. Its
# nonroot tag already runs as uid 65532, which satisfies the chart's
# runAsNonRoot check.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/app /app
EXPOSE {%.Port%}
USER nonroot:nonroot
ENTRYPOINT ["/app"]
