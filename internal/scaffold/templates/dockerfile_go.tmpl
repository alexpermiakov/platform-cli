# {%.Name%} — built by CI, deployed by ArgoCD.
#
# Generated by platform-cli. The platform runs this image non-root with a
# read-only root filesystem and every capability dropped, so the runtime stage
# must not write outside an explicitly mounted volume.

FROM golang:1.24-alpine AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
# CI passes the git tag; it ends up in /version and your metrics.
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath \
      -ldflags "-s -w -X main.version=${VERSION}" \
      -o /out/app .

# distroless/static: no shell, no package manager, nothing to exploit. Its
# nonroot tag is uid 65532.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/app /app
EXPOSE {%.Port%}
# Numeric, not `nonroot`. The chart sets runAsNonRoot without pinning runAsUser,
# and the kubelet cannot resolve a username against the image at admission: a
# named USER fails with "cannot verify user is non-root" and never starts.
USER 65532:65532
ENTRYPOINT ["/app"]
