# {%.Service.Name%} — {%.Env%}
#
# Generated by platform-cli. Owned by {%.Service.Team%}.
# Rendered against the platform's standard-service chart; every key not set
# here comes from helm-charts/standard-service/values.yaml.
#
# The filename must stay {%.Service.Name%}.yaml — ArgoCD's ApplicationSet
# derives both the Application name and the namespace from it.

{%- if .Service.ChartVersion%}
# Pins the standard-service chart. Remove this to track the platform default
# and pick up chart releases automatically.
chartVersion: {%.Service.ChartVersion%}
{%end%}
app:
  name: {%.Service.Name%}
  image: {%.Service.Image%}
  port: {%.Service.Port%}
  team: {%.Service.Team%}

# T-shirt size, not raw cpu/memory: the platform team owns what each size
# means. Bump prod here if load requires it.
resourceProfile: {%.Service.Profile%}
{%if .Service.Ingress%}
ingress:
  enabled: true
  path: {%.Service.IngressPath%}
  annotations:
    alb.ingress.kubernetes.io/healthcheck-port: "{%.Service.Port%}"

# Cilium default-denies ingress; these are the paths reachable from outside.
cilium:
  publicPaths:
    - "{%.Service.IngressPath%}"
    - "{%.Service.IngressPath%}/*"
{%else%}
ingress:
  enabled: false
{%end%}{%if .HasRollout%}
rollout:
{%- if not .Service.Ingress%}
  # Canary needs an ALB to split traffic, so a service without an ingress
  # uses blue/green. The chart fails the render otherwise.
  strategy: blueGreen
{%- end%}
{%- if .DevAnalysis%}
  analysis:
    # Dev sees little traffic; don't gate promotion on a request-rate floor.
    minRps: "0"
{%- end%}
{%end%}
